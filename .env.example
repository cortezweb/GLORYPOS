# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Dominio base de los subdominios de cada empresa (ej. tienda-sol.glorypos.com.bo)
VITE_BASE_DOMAIN=glorypos.com.bo

# true = modo demo: datos y usuarios de prueba solo en el navegador, sin exigir Supabase Auth
VITE_DEMO_MODE=false

# Dirección de la API en Railway (para enviar cotizaciones por correo)
VITE_API_URL=https://tu-api.up.railway.app
